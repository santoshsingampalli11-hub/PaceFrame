# Placeholders only. Do not put real secrets or personal data here.
# Copy to a file that is not committed if a host needs these values.

# Absolute path, or a path relative to the backend directory.
# Leave unset to use backend/local_sessions.
FAST_BOWLING_SESSION_ROOT=

# Upload cap in bytes. Default is 83886080 (80 MiB).
FAST_BOWLING_MAX_UPLOAD_BYTES=

# One delivery. Defaults: 1800 decoded frames and 30 seconds.
FAST_BOWLING_MAX_DECODED_FRAMES=
FAST_BOWLING_MAX_DURATION_SECONDS=

# One process. Default is 1 concurrent pose or measurement job.
FAST_BOWLING_MAX_POSE_JOBS=

# Comma-separated browser origins. No wildcard.
# Default is http://localhost:5173,http://127.0.0.1:5173
FAST_BOWLING_CORS_ORIGINS=

# Comma-separated host names. No wildcard. No X-Forwarded-Host trust.
# Default includes localhost, 127.0.0.1, and testserver.
FAST_BOWLING_TRUSTED_HOSTS=

# In-process limits for this single server. Default on.
FAST_BOWLING_RATE_LIMIT=1
FAST_BOWLING_UPLOAD_LIMIT=40
FAST_BOWLING_JOB_LIMIT=20
FAST_BOWLING_RATE_WINDOW_SECONDS=600

# Production frontend build only. Empty means same-origin /api.
VITE_API_BASE_URL=
